# Managed by Ansible (ops/ansible) — Caddy for {{ site_domain }} (Let's Encrypt).
# Apex serves the static site; www redirects to apex; dashboard is password-protected.
{
	email {{ caddy_admin_email }}
	# Disable the unauthenticated localhost admin API (default :2019). Config is
	# fully static and applied by Ansible, so we never need the live admin/config
	# API; leaving it on would give any local process a control plane that can
	# extract TLS keys. Trade-off: `caddy reload` no longer works, so the caddy
	# role's handler does a full `systemctl restart` (brief blip on config change).
	admin off
	# Pin ACME to Let's Encrypt (Caddy's default also adds a ZeroSSL fallback).
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

www.{{ site_domain }} {
	redir https://{{ site_domain }}{uri} permanent
}

{{ site_domain }} {
	encode gzip
	header {
		# No includeSubDomains: this apex shouldn't force HTTPS onto sibling
		# subdomains (e.g. toolkit.socialnetwork.health) that may live elsewhere.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	root * {{ site_root }}
	file_server
}

# Team dashboard — generated by the private snh-aios repo. Team-only content: never indexed, never
# cached, and never served without sign-in. Google sign-in (oauth2-proxy) when its client is
# configured; else the shared password; else nothing (503).
{{ dashboard_domain }} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}
{% if dashboard_oauth_client_id | default('') %}
	# Sign-in pages and the OAuth callback go straight to oauth2-proxy.
	handle /oauth2/* {
		reverse_proxy {{ oauth2_proxy_listen | default('127.0.0.1:4180') }} {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}
	# Everything else: ask oauth2-proxy first; not signed in -> Google sign-in.
	handle {
		forward_auth {{ oauth2_proxy_listen | default('127.0.0.1:4180') }} {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			@error status 401
			handle_response @error {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}
		root * {{ dashboard_root }}
		file_server
	}
{% elif dashboard_auth_hash | default('') %}
	basic_auth {
		{{ dashboard_auth_user | default('snh') }} {{ dashboard_auth_hash }}
	}
	root * {{ dashboard_root }}
	file_server
{% else %}
	# Fail closed: no sign-in configured in ops/ansible/secrets/ on the machine that ran Ansible.
	respond "Dashboard not configured" 503
{% endif %}
}
