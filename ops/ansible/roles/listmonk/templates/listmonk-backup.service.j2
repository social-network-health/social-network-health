# Managed by Ansible (ops/ansible roles/listmonk).
# A consistent dump of the subscriber list, which the droplet's daily backup then copies off the
# box. Keeps {{ listmonk_backup_keep_days }} days.
[Unit]
Description=Dump listmonk's database to {{ listmonk_backup_dir }}
Requires=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=listmonk
Group=listmonk
UMask=0077
ExecStart=/bin/sh -c 'pg_dump --format=custom --file={{ listmonk_backup_dir }}/listmonk-$(date +%%F).dump listmonk'
ExecStart=/usr/bin/find {{ listmonk_backup_dir }} -name 'listmonk-*.dump' -mtime +{{ listmonk_backup_keep_days }} -delete
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ listmonk_backup_dir }}
ProtectHome=true
PrivateTmp=true
